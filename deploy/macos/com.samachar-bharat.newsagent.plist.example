<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.samachar-bharat.newsagent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/Documents/NewsAgent/.venv/bin/python</string>
    <string>-m</string>
    <string>newsagent.cli</string>
    <string>production</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/Documents/NewsAgent</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>src</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/samachar-bharat-newsagent.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/samachar-bharat-newsagent.err.log</string>
</dict>
</plist>
