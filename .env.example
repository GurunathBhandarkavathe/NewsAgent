# Copy this file to .env and fill only the values you need.

# Brand/page identity
BRAND_NAME=Samachar Bharat
BRAND_HANDLE=@smachar.bh
BRAND_TAGLINE=Bharat in 5 slides. Every 3 hours.
BRAND_BIO=Top Bharat stories in 5 quick slides. Politics, films, sports, current affairs and world news.

# Local storage
NEWSAGENT_DATA_DIR=data
NEWSAGENT_ASSETS_DIR=assets
NEWSAGENT_SESSION_PATH=data/session-store.json

# Runtime
TIMEZONE=Asia/Kolkata
CYCLE_HOURS=3
DEDUPE_HOURS=48
DRAFT_MIN_ITEMS=4
DRAFT_MAX_ITEMS=5
# separate_posts publishes each slide as its own feed post; carousel publishes one multi-slide post.
POST_FORMAT=separate_posts
ARTICLE_DETAIL_ENRICHMENT=true
REQUIRE_REAL_IMAGES=false
IMAGE_POLICY=branded_cards
IMAGE_ENRICHMENT_LIMIT=80
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Optional. If set, dashboard forms require ?token=... or X-NewsAgent-Token.
DASHBOARD_TOKEN=

# News sources. Format: category=url;category=url
# If blank, the app uses built-in direct publisher RSS defaults for India.
RSS_FEEDS=
GOOGLE_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=IN
ENABLE_RSS=true
ENABLE_GDELT=true
ENABLE_GOOGLE_TRENDS=true

# Instagram reference pages for future style guidance, comma-separated.
REFERENCE_INSTAGRAM_PAGES=

# Meta Instagram publishing.
# Required only when you want approved drafts to publish automatically.
META_GRAPH_VERSION=v26.0
# Leave blank for auto. IGAA Instagram Login tokens use graph.instagram.com;
# EAA Facebook Login tokens use graph.facebook.com.
META_API_HOST=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=

# Meta requires public HTTPS image URLs. Point this to a public URL that serves
# NEWSAGENT_ASSETS_DIR, for example an HTTPS tunnel or deployed static host.
# If the URL points to this dashboard, use:
# https://YOUR-HTTPS-HOST/public-assets/PUBLIC_ASSET_TOKEN/
PUBLIC_ASSET_TOKEN=
PUBLIC_ASSET_BASE_URL=
